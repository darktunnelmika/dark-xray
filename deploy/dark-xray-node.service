[Unit]
Description=DARK XRAY lightweight Node Agent
After=network-online.target dark-xray-node-guard.service
Wants=network-online.target dark-xray-node-guard.service

[Service]
Type=simple
User=darkxray
Group=darkxray
WorkingDirectory=/opt/dark-xray-node
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONNOUSERSITE=1
ExecStart=/opt/dark-xray-node/.venv/bin/python /opt/dark-xray-node/backend/node_agent.py --config /etc/dark-xray-node/config.json --data /var/lib/dark-xray-node --token-file /var/lib/dark-xray-node/token --node-id-file /var/lib/dark-xray-node/node-id
Restart=on-failure
RestartSec=4
TimeoutStopSec=60
# Kill the complete owned cgroup if the safety loop stalls; never an unconditional feed.
NotifyAccess=main
WatchdogSec=30
WatchdogSignal=SIGKILL
TimeoutAbortSec=1
KillMode=control-group
SendSIGKILL=yes
UMask=0077
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/var/lib/dark-xray-node /run/dark-xray-guard

[Install]
WantedBy=multi-user.target
