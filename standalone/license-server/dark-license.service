[Unit]
Description=DARK License Authority
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=dark-license
Group=dark-license
EnvironmentFile=/etc/dark-license/env
WorkingDirectory=/opt/dark-license
ExecStart=/opt/dark-license/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8099 --no-access-log
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/dark-license
[Install]
WantedBy=multi-user.target